# Host slice the benchmark container gets.  Copy to .env and adjust to this
# machine; docker-compose.yml refuses to start without these.

# Host CPUs the container may run on.  Generate it rather than typing it -- the
# value has to hold whole physical cores and whole NUMA nodes, and SMT siblings
# are rarely adjacent, so a contiguous range is usually wrong:
#
#   lscpu -e=CPU,CORE,SOCKET,NODE | python3 scripts/pick_cpuset.py --cpus 256 --whole-nodes
#
# Below is that command's answer for a 384-CPU host of 8 NUMA nodes with 24
# SMT-2 cores each: nodes 1-5 entire, 240 logical CPUs on 120 physical cores.
# Drop --whole-nodes to land on 256 exactly, at the cost of sharing node 6's
# memory bandwidth with whatever else is on it.
BENCH_CPUSET=24-143,216-335

# Memory share, in docker's suffixes (b, k, m, g -- there is no t).  4 TB:
BENCH_MEM=4096g

# Owner of the checkout, so what a run writes into the mount does not come back
# owned by root.
UID=1002
GID=100
